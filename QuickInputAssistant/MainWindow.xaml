<Window
    x:Class="QuickInputAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快捷输入助手">

    <!-- 真透明：靠 WinUIEx.TransparentTintBackdrop 实现窗口真透明，
         圆角 Border 由 WinUI3 自己抗锯齿渲染，无白边无锯齿。
         UseLayoutRounding=True 强制元素位置对齐整数像素，避免子像素糊 -->
    <Grid x:Name="RootGrid" Background="Transparent"
          UseLayoutRounding="True">

        <StackPanel x:Name="MainLayout" Spacing="4" VerticalAlignment="Top">

            <!-- ═══ Status Bar：三种模式完全统一 ═══ -->
            <Border x:Name="StatusBar" CornerRadius="15" Height="30"
                    Width="344" HorizontalAlignment="Center"
                    Padding="10,0,4,0"
                    PointerPressed="OnDragAreaPressed"
                    PointerMoved="OnDragAreaMoved"
                    PointerReleased="OnDragAreaReleased"
                    PointerCaptureLost="OnDragAreaCaptureLost">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                                Background="Transparent">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 IsHitTestVisible="False"/>
                        <TextBlock x:Name="StatusText" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="快捷输入助手运行中…" IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel x:Name="ActionButtons" Grid.Column="1"
                                Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ═══ Content Area: hidden in Capsule mode ═══ -->
            <StackPanel x:Name="ContentArea" Spacing="0">

                <!-- Keyboard Layout: 3 个独立圆角行，形成阶梯轮廓。
                     HorizontalAlignment="Center" 让整个键盘组在窗口内居中，
                     第一排（最宽）自然居中对齐状态栏；2/3 行相对第一排左缩进保持阶梯 -->
                <StackPanel x:Name="KBContent" Spacing="2" HorizontalAlignment="Center">
                    <Border x:Name="KBRow1Border" CornerRadius="8"
                            Padding="3" HorizontalAlignment="Left"
                            PointerPressed="OnDragAreaPressed"
                            PointerMoved="OnDragAreaMoved"
                            PointerReleased="OnDragAreaReleased"
                            PointerCaptureLost="OnDragAreaCaptureLost">
                        <StackPanel x:Name="KBRow1" Orientation="Horizontal" Spacing="3"/>
                    </Border>
                    <Border x:Name="KBRow2Border" CornerRadius="8"
                            Padding="3" HorizontalAlignment="Left" Margin="22,0,0,0"
                            PointerPressed="OnDragAreaPressed"
                            PointerMoved="OnDragAreaMoved"
                            PointerReleased="OnDragAreaReleased"
                            PointerCaptureLost="OnDragAreaCaptureLost">
                        <StackPanel x:Name="KBRow2" Orientation="Horizontal" Spacing="3"/>
                    </Border>
                    <Border x:Name="KBRow3Border" CornerRadius="8"
                            Padding="3" HorizontalAlignment="Left" Margin="34,0,0,0"
                            PointerPressed="OnDragAreaPressed"
                            PointerMoved="OnDragAreaMoved"
                            PointerReleased="OnDragAreaReleased"
                            PointerCaptureLost="OnDragAreaCaptureLost">
                        <StackPanel x:Name="KBRow3" Orientation="Horizontal" Spacing="3"/>
                    </Border>
                </StackPanel>

                <!-- List Layout -->
                <Border x:Name="ListContent" Visibility="Collapsed"
                        CornerRadius="8"
                        PointerPressed="OnDragAreaPressed"
                        PointerMoved="OnDragAreaMoved"
                        PointerReleased="OnDragAreaReleased"
                        PointerCaptureLost="OnDragAreaCaptureLost">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ListCol1" Padding="0,4"/>
                        <Border x:Name="ListDivider" Grid.Column="1" Width="1" Margin="0,4"/>
                        <StackPanel x:Name="ListCol2" Grid.Column="2" Padding="0,4"/>
                    </Grid>
                </Border>

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
