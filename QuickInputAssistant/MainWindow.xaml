<Window
    x:Class="QuickInputAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快捷输入助手">

    <Grid x:Name="RootGrid" Background="#FF141416" Padding="4">

        <!-- ═══ Mode: Capsule ═══ -->
        <Border x:Name="CapsuleView" Visibility="Collapsed"
                CornerRadius="13" Height="26" HorizontalAlignment="Left"
                Background="#F0141416" BorderBrush="#1AFFFFFF" BorderThickness="1"
                Padding="8,0,3,0" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                            PointerPressed="OnDragAreaPressed">
                    <TextBlock Text="⋮⋮" FontSize="8" Foreground="#6BFFFFFF"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Ellipse x:Name="CapsuleDot" Width="6" Height="6" Fill="#8CFFFFFF"/>
                    <TextBlock x:Name="CapsuleStatusText" FontSize="9" Foreground="#8CFFFFFF"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="150" Text="快捷输入助手运行中…" IsHitTestVisible="False"/>
                </StackPanel>
                <Border Grid.Column="1" PointerPressed="OnExpandClick"
                        Background="Transparent" Padding="4,0" VerticalAlignment="Center">
                    <TextBlock Text="⌄" FontSize="11" Foreground="#B3FFFFFF"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Mode: Expanded (Keyboard / List) ═══ -->
        <StackPanel x:Name="ExpandedView" Spacing="4" VerticalAlignment="Top">

            <!-- Shared Status Bar -->
            <Border CornerRadius="12" Height="24" Width="220" HorizontalAlignment="Center"
                    Background="#F0141416" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    Padding="8,0,3,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                                PointerPressed="OnDragAreaPressed">
                        <TextBlock Text="⋮⋮" FontSize="8" Foreground="#6BFFFFFF"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8CFFFFFF"/>
                        <TextBlock x:Name="StatusText" FontSize="9" Foreground="#8CFFFFFF"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="快捷输入助手运行中…" IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel x:Name="ActionButtons" Grid.Column="1"
                                Orientation="Horizontal" Spacing="1"/>
                </Grid>
            </Border>

            <!-- Keyboard Layout -->
            <StackPanel x:Name="KBContent" Spacing="2">
                <!-- Row 1: 1-6 -->
                <Border CornerRadius="8" Background="#DB121216"
                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Padding="3" HorizontalAlignment="Left">
                    <StackPanel x:Name="KBRow1" Orientation="Horizontal" Spacing="3"/>
                </Border>
                <!-- Row 2: Q W E R (indented) -->
                <Border CornerRadius="8" Background="#DB121216"
                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Padding="3" HorizontalAlignment="Left" Margin="22,0,0,0">
                    <StackPanel x:Name="KBRow2" Orientation="Horizontal" Spacing="3"/>
                </Border>
                <!-- Row 3: A S D F (indented more) -->
                <Border CornerRadius="8" Background="#DB121216"
                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Padding="3" HorizontalAlignment="Left" Margin="34,0,0,0">
                    <StackPanel x:Name="KBRow3" Orientation="Horizontal" Spacing="3"/>
                </Border>
            </StackPanel>

            <!-- List Layout -->
            <Border x:Name="ListContent" Visibility="Collapsed"
                    CornerRadius="8" Background="#F0141416"
                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ListCol1" Padding="0,4"/>
                    <Border Grid.Column="1" Width="1" Background="#0FFFFFFF" Margin="0,4"/>
                    <StackPanel x:Name="ListCol2" Grid.Column="2" Padding="0,4"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
